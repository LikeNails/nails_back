{
	"compilerOptions": {
		"outDir": "./dist/",
		"noImplicitAny": true,
		"module": "CommonJS",
		"target": "es6",
		"strict": true,
		"allowJs": true,
		"sourceMap": true,
		"moduleResolution": "node",
		//нужныы, чтобы правильно обрабатывать импорты
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true
	},
	"include": ["src/**/*", "./*.js"],
	"exclude": ["node_modules", "dist", "*.tmp", "*.log"]
}
