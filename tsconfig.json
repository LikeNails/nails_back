{
	"compilerOptions": {
		"outDir": "./dist/",
		"noImplicitAny": true,
		"module": "CommonJS",
		"target": "es6",
		"strict": true,
		"allowJs": true,
		"sourceMap": true,
		//нужныы, чтобы правильно обрабатывать импорты
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"baseUrl": "."
		// "paths": {
		// 	"@/*": ["src/*"]
		// }
	},
	"include": ["src/**/*", "./*.js"],
	"exclude": ["node_modules", "dist", "*.tmp", "*.log"]
}
