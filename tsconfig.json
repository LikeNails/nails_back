{
	"compilerOptions": {
		"outDir": "./dist/",
		"noImplicitAny": true,
		"module": "CommonJS",
		"target": "es6",
		"strict": true,
		"allowJs": true,
		"sourceMap": true,
		"moduleResolution": "node",
		//нужныы, чтобы правильно обрабатывать импорты
		"allowSyntheticDefaultImports": true, // позволяет работать с CommonJs, получаем объект
		"esModuleInterop": true // уходим от * as , подменяем отсутствующий export default
	},
	"include": [
		"src/**/*",
		"./*.js"
	],
	"exclude": [
		"node_modules", 
		"dist", 
		"*.tmp", 
		"*.log"
	],
	"ts-node": {
		"compilerOptions": {
			"sourceMap": true
		}
	}
}
